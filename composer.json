{
    "name": "toneflix/approvable-notifications",
    "description": "A Laravel package to handle database notifications that require user interactions",
    "keywords": [
        "toneflix",
        "approvable-notifications"
    ],
    "homepage": "https://github.com/toneflix/laravel-approvable-notifications",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Toneflix Code",
            "email": "code@toneflix.com.ng",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3|^8.4",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "illuminate/contracts": "^12.0|^13.0",
        "imanghafoori/php-imports-analyzer": "^1.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.11|^11.1",
        "pestphp/pest": "^4.4",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "Toneflix\\ApprovableNotifications\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Toneflix\\ApprovableNotifications\\Tests\\": "tests",
            "Toneflix\\ApprovableNotifications\\Tests\\Database\\Factories\\": "tests/database/factories"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "clear": "@php vendor/bin/testbench package:purge-laravel-pay-pocket --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": [
            "@composer run prepare",
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "@composer run build",
            "@php vendor/bin/testbench serve"
        ],
        "analyse": "vendor/bin/phpstan analyse",
        "test": "XDEBUG_MODE=coverage ./vendor/bin/pest --coverage",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Toneflix\\ApprovableNotifications\\ApprovableNotificationsServiceProvider"
            ],
            "aliases": {
                "ApprovableNotifications": "Toneflix\\ApprovableNotifications\\ApprovableNotificationsFacade"
            }
        }
    }
}
